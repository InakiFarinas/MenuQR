{
	"compilerOptions": {
		"baseUrl": ".",
		"allowJs": true,
		"checkJs": false,
		"ignoreDeprecations": "6.0",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"target": "ES2020",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["src"],
	"references": []
}
